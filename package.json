{
  "name": "groundcontrol",
  "version": "0.1.0",
  "description": "Air traffic control for your Claude Code agents: every running claude process as a flight on a taxiway from the app or script that launched it, showing who's working, holding for you, or awaiting clearance.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "groundcontrol": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "monitoring",
    "observability",
    "dashboard"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch src/cli.ts --no-open --port 4317\" \"vite\"",
    "dev:demo": "concurrently -k -n server,web -c cyan,magenta \"tsx watch src/cli.ts --demo --no-open --port 4317\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/cli.js",
    "demo": "node dist/server/cli.js --demo",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/reddit-sans": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djcopp/groundcontrol.git"
  },
  "homepage": "https://github.com/djcopp/groundcontrol#readme",
  "bugs": {
    "url": "https://github.com/djcopp/groundcontrol/issues"
  }
}
